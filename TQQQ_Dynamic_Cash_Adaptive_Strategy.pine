// https://mozilla.org/MPL/2.0/

//@version=5
indicator("TQQQ Dynamic Cash-Adaptive Strategy [Dual-Gate NDX+EMA]", 
     overlay=true, 
     max_labels_count=500, 
     max_bars_back=5000)

// =============================================================================
// AUDITED PARAMETERS — Confirmed from backtest CSV (2010–2026)
// =============================================================================

// --- Dual-Gate Filter ---
grp_gate = "Dual-Gate Filter (NDX + EMA)"
ndx_ticker        = input.symbol("NASDAQ:NDX", "Nasdaq-100 Index", group=grp_gate, tooltip="Benchmark for dual-gate filter")
show_gate_status  = input.bool(true, "Show Gate Status on Chart", group=grp_gate)

// --- Core Harvest Settings ---
grp_harvest = "Profit Harvest"
ema_period        = input.int(200, "EMA Period (days)", group=grp_harvest, minval=5)
harvest_dist_pct  = input.float(50.0, "Profit Harvest Distance (%)", group=grp_harvest, step=5.0)
hysteresis_pct    = input.float(35.0, "Hysteresis Reset Buffer (%)", group=grp_harvest, step=5.0)
scale_out_pct     = input.float(75.0, "Initial Scale-Out (%)", group=grp_harvest, minval=1, maxval=100)
step_increment    = input.float(20.0, "Step Trigger Increment (%)", group=grp_harvest, step=5.0)
step_sell_pct     = input.float(10.0, "Step Scale-Out Share (%)", group=grp_harvest, minval=1, maxval=100)

// --- Tranche Settings ---
grp_tranche = "Tranche Dip-Buy"
t1_threshold      = input.float(-20.0, "Tranche 1 Threshold (%)", group=grp_tranche)
t2_threshold      = input.float(-35.0, "Tranche 2 Threshold (%)", group=grp_tranche)
t3_threshold      = input.float(-45.0, "Tranche 3 Threshold (%)", group=grp_tranche)
t4_threshold      = input.float(-65.0, "Tranche 4 Threshold (%)", group=grp_tranche)
cash_deploy_pct   = input.float(25.0, "Cash Deploy per Tranche (%)", group=grp_tranche, minval=1, maxval=100)

// --- Contributions ---
grp_contrib = "Weekly Contributions"
base_deposit      = input.float(200.0, "Base Weekly Deposit ($)", group=grp_contrib, minval=0)
ob_deposit        = input.float(200.0, "Overbought Deposit ($)", group=grp_contrib, minval=0)
tranche_deposit   = input.float(400.0, "Tranche Deposit ($)", group=grp_contrib, minval=0)

// --- Cash Yield ---
grp_yield = "Cash Yield"
cash_apy          = input.float(4.5, "Cash Buffer APY (%)", group=grp_yield, minval=0)

// --- Display ---
grp_display = "Display"
show_ema          = input.bool(true, "Show 200 EMA", group=grp_display)
show_bands        = input.bool(true, "Show Harvest/Reset Bands", group=grp_display)
show_markers      = input.bool(true, "Show Trade Markers", group=grp_display)

// =============================================================================
// EMA & NASDAQ-100 BENCHMARK
// =============================================================================
ema200 = ta.ema(close, ema_period)

// Fetch Nasdaq-100 index close price (normalized for comparison)
// We compare TQQQ's position relative to its own EMA AND the NDX trend
ndx_close = request.security(ndx_ticker, timeframe.period, close)
ndx_ema200 = request.security(ndx_ticker, timeframe.period, ta.ema(close, ema_period))

// =============================================================================
// DUAL-GATE LOGIC
// =============================================================================
// Gate 1: TQQQ price must be above its own 200 EMA
gate_above_ema = close > ema200

// Gate 2: Nasdaq-100 must be above its own 200 EMA (trend confirmation)
gate_ndx_bullish = ndx_close > ndx_ema200

// DUAL-GATE: Both must be true for buying to be active
dual_gate_open = gate_above_ema and gate_ndx_bullish

// RISK-OFF: Both gates failed — price below EMA AND NDX below its EMA
risk_off_triggered = (close < ema200) and (ndx_close < ndx_ema200)

// =============================================================================
// STATE MACHINE — Persistent Variables
// =============================================================================
var bool   in_overbought      = false
var int    n_harvest           = 0
var float  swing_high_peak    = 0.0
var float  cash_buffer         = 0.0
var float  peak_cash_buffer    = 0.0
var float  total_shares        = 0.0
var float  total_oop           = 0.0
var bool   risk_off_active    = false

// Tranche flags (sequential gating)
var bool   t1_fired = false
var bool   t2_fired = false
var bool   t3_fired = false
var bool   t4_fired = false

// Step scale-out tracking
var bool   step1_fired = false
var bool   step2_fired = false
var bool   step3_fired = false

// Weekly deposit tracking
var int    last_deposit_week = -1
var int    last_deposit_year = -1
var bool   tranche_this_week = false
var int    week_tracked      = -1
var int    year_tracked      = -1

// =============================================================================
// DERIVED CALCULATIONS
// =============================================================================
dist_pct = ema200 > 0 ? ((close - ema200) / ema200) * 100.0 : 0.0
pullback_pct = swing_high_peak > 0 ? ((close - swing_high_peak) / swing_high_peak) * 100.0 : 0.0

// Weekly boundary
current_week = weekofyear(time)
current_year = year(time)
is_monday = (dayofweek(time) == dayofweek.monday)
new_week = (current_week != week_tracked) or (current_year != year_tracked)

// Daily yield factor
daily_yield = 1.0 + (cash_apy / 100.0) / 252.0

// =============================================================================
// ENGINE EXECUTION — Every bar (daily)
// =============================================================================
var string bar_action = "HOLD"
var float  bar_deposit = 0.0
bar_action := "HOLD"
bar_deposit := 0.0

// Reset weekly tracking
if new_week
    tranche_this_week := false
    week_tracked := current_week
    year_tracked := current_year

// --- PHASE 1: Daily Cash Yield ---
if cash_buffer > 0
    cash_buffer := cash_buffer * daily_yield

// --- PHASE 2: RISK-OFF EXIT ---
// If price is below BOTH the 200 EMA AND Nasdaq-100 is below its EMA:
// Sell ALL remaining unharvested shares immediately
if risk_off_triggered and total_shares > 0 and not risk_off_active
    risk_off_active := true
    // Sell 100% of remaining position
    cash_buffer := cash_buffer + total_shares * close
    total_shares := 0.0
    in_overbought := false
    bar_action := "RISK-OFF EXIT"

// Reset risk-off when dual gate reopens
if dual_gate_open and risk_off_active
    risk_off_active := false

// --- PHASE 3: Hysteresis Reset ---
if in_overbought and dist_pct < hysteresis_pct
    in_overbought := false
    step1_fired := false
    step2_fired := false
    step3_fired := false

// --- PHASE 4: Profit Harvest (+50% trigger) ---
// Profit harvesting can fire regardless of gate (it's a SELL, not a buy)
if dist_pct >= harvest_dist_pct and not in_overbought and total_shares > 0
    in_overbought := true
    n_harvest := n_harvest + 1
    swing_high_peak := close
    
    shares_sold = total_shares * (scale_out_pct / 100.0)
    cash_buffer := cash_buffer + shares_sold * close
    total_shares := total_shares - shares_sold
    
    peak_cash_buffer := cash_buffer
    
    t1_fired := false
    t2_fired := false
    t3_fired := false
    t4_fired := false
    step1_fired := false
    step2_fired := false
    step3_fired := false
    
    bar_action := "PROFIT TAKE"

else if in_overbought
    swing_high_peak := math.max(swing_high_peak, close)
    
    // Step scale-outs (SELLS — allowed regardless of gate)
    float step1_level = harvest_dist_pct + step_increment * 1
    float step2_level = harvest_dist_pct + step_increment * 2
    float step3_level = harvest_dist_pct + step_increment * 3
    
    if dist_pct >= step1_level and not step1_fired and total_shares > 0
        step_shares = total_shares * (step_sell_pct / 100.0)
        cash_buffer := cash_buffer + step_shares * close
        total_shares := total_shares - step_shares
        step1_fired := true
        bar_action := "STEP +70%"
    else if dist_pct >= step2_level and not step2_fired and total_shares > 0
        step_shares = total_shares * (step_sell_pct / 100.0)
        cash_buffer := cash_buffer + step_shares * close
        total_shares := total_shares - step_shares
        step2_fired := true
        bar_action := "STEP +90%"
    else if dist_pct >= step3_level and not step3_fired and total_shares > 0
        step_shares = total_shares * (step_sell_pct / 100.0)
        cash_buffer := cash_buffer + step_shares * close
        total_shares := total_shares - step_shares
        step3_fired := true
        bar_action := "STEP +110%"

// --- PHASE 5: Tranche Dip-Buys ---
// DUAL-GATE REQUIRED: Only buy when price > EMA AND NDX > NDX_EMA
bool tranche_fired_today = false

if dual_gate_open and not risk_off_active
    if pullback_pct <= t1_threshold and not t1_fired and swing_high_peak > 0
        t1_fired := true
        tranche_fired_today := true
        tranche_this_week := true
        n_harvest := 0
        deploy_amt = math.min(peak_cash_buffer * (cash_deploy_pct / 100.0), cash_buffer)
        total_buy = deploy_amt + tranche_deposit
        total_shares := total_shares + (total_buy / close)
        cash_buffer := cash_buffer - deploy_amt
        total_oop := total_oop + tranche_deposit
        bar_deposit := tranche_deposit
        bar_action := "TRANCHE 1"

    else if pullback_pct <= t2_threshold and t1_fired and not t2_fired and swing_high_peak > 0
        t2_fired := true
        tranche_fired_today := true
        tranche_this_week := true
        n_harvest := 0
        deploy_amt = math.min(peak_cash_buffer * (cash_deploy_pct / 100.0), cash_buffer)
        total_buy = deploy_amt + tranche_deposit
        total_shares := total_shares + (total_buy / close)
        cash_buffer := cash_buffer - deploy_amt
        total_oop := total_oop + tranche_deposit
        bar_deposit := tranche_deposit
        bar_action := "TRANCHE 2"

    else if pullback_pct <= t3_threshold and t2_fired and not t3_fired and swing_high_peak > 0
        t3_fired := true
        tranche_fired_today := true
        tranche_this_week := true
        n_harvest := 0
        deploy_amt = math.min(peak_cash_buffer * (cash_deploy_pct / 100.0), cash_buffer)
        total_buy = deploy_amt + tranche_deposit
        total_shares := total_shares + (total_buy / close)
        cash_buffer := cash_buffer - deploy_amt
        total_oop := total_oop + tranche_deposit
        bar_deposit := tranche_deposit
        bar_action := "TRANCHE 3"

    else if pullback_pct <= t4_threshold and t3_fired and not t4_fired and swing_high_peak > 0
        t4_fired := true
        tranche_fired_today := true
        tranche_this_week := true
        n_harvest := 0
        deploy_amt = math.min(peak_cash_buffer * (cash_deploy_pct / 100.0), cash_buffer)
        total_buy = deploy_amt + tranche_deposit
        total_shares := total_shares + (total_buy / close)
        cash_buffer := cash_buffer - deploy_amt
        total_oop := total_oop + tranche_deposit
        bar_deposit := tranche_deposit
        bar_action := "TRANCHE 4"

// --- PHASE 6: Monday DCA ---
// DUAL-GATE REQUIRED: Only buy when both gates open
if is_monday and (current_week != last_deposit_week or current_year != last_deposit_year)
    last_deposit_week := current_week
    last_deposit_year := current_year
    
    float monday_deposit = 0.0
    if tranche_this_week
        monday_deposit := 0.0
    else if not dual_gate_open or risk_off_active
        // Gate closed — DCA paused, cash stays in buffer earning yield
        monday_deposit := 0.0
    else if in_overbought
        monday_deposit := ob_deposit
    else
        monday_deposit := base_deposit
    
    if monday_deposit > 0
        total_shares := total_shares + (monday_deposit / open)
        total_oop := total_oop + monday_deposit
        bar_deposit := bar_deposit + monday_deposit
        if bar_action == "HOLD"
            bar_action := in_overbought ? "DCA (OB)" : "DCA"

// =============================================================================
// PORTFOLIO VALUATION
// =============================================================================
portfolio_value = (total_shares * close) + cash_buffer

// =============================================================================
// VISUAL: EMA & Distance Bands
// =============================================================================
plot(show_ema ? ema200 : na, "200 EMA", color=color.new(color.orange, 0), linewidth=2)

ema_harvest_line = ema200 * (1 + harvest_dist_pct / 100.0)
ema_hysteresis_line = ema200 * (1 + hysteresis_pct / 100.0)
plot(show_bands ? ema_harvest_line : na, "+50% Harvest", color=color.new(color.red, 65), linewidth=1)
plot(show_bands ? ema_hysteresis_line : na, "+35% Reset", color=color.new(color.yellow, 65), linewidth=1)

// =============================================================================
// VISUAL: Trade Markers
// =============================================================================
plotshape(show_markers and bar_action == "PROFIT TAKE", title="Harvest",
     style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.normal, text="HARVEST\n75%")

is_step = str.contains(bar_action, "STEP")
plotshape(show_markers and is_step, title="Step",
     style=shape.diamond, location=location.abovebar,
     color=color.orange, size=size.small, text="STEP")

is_tranche = str.contains(bar_action, "TRANCHE")
plotshape(show_markers and is_tranche, title="Tranche",
     style=shape.triangleup, location=location.belowbar,
     color=color.green, size=size.normal, text="BUY")

is_dca = str.contains(bar_action, "DCA")
plotshape(show_markers and is_dca, title="DCA",
     style=shape.circle, location=location.belowbar,
     color=color.new(color.blue, 40), size=size.tiny)

// Risk-Off Exit marker (purple skull)
plotshape(show_markers and bar_action == "RISK-OFF EXIT", title="Risk-Off",
     style=shape.triangledown, location=location.abovebar,
     color=color.purple, size=size.large, text="RISK-OFF\nEXIT")

// Hysteresis Reset
was_overbought = in_overbought[1] and not in_overbought
plotshape(show_markers and was_overbought, title="Reset",
     style=shape.xcross, location=location.belowbar,
     color=color.yellow, size=size.small, text="RESET")

// =============================================================================
// BACKGROUND — Regime & Gate coloring
// =============================================================================
bgcolor(in_overbought ? color.new(color.red, 93) : na, title="Overbought Zone")
bgcolor(is_tranche ? color.new(color.green, 88) : na, title="Tranche Day")
bgcolor(bar_action == "PROFIT TAKE" ? color.new(color.red, 85) : na, title="Harvest Day")
bgcolor(risk_off_active ? color.new(color.purple, 90) : na, title="Risk-Off Active")
bgcolor(not dual_gate_open and not risk_off_active ? color.new(color.gray, 94) : na, title="Gate Closed (Paused)")

// =============================================================================
// DATA WINDOW — Complete state on hover
// =============================================================================
plot(dist_pct, "EMA Distance (%)", display=display.data_window, color=color.new(color.purple, 100))
plot(ema200, "200 EMA ($)", display=display.data_window, color=color.new(color.orange, 100))
plot(dual_gate_open ? 1 : 0, "Dual Gate Open (1=Yes)", display=display.data_window, color=color.new(color.white, 100))
plot(risk_off_active ? 1 : 0, "Risk-Off Active (1=Yes)", display=display.data_window, color=color.new(color.white, 100))
plot(gate_above_ema ? 1 : 0, "Gate: Price > EMA (1=Yes)", display=display.data_window, color=color.new(color.white, 100))
plot(gate_ndx_bullish ? 1 : 0, "Gate: NDX > NDX_EMA (1=Yes)", display=display.data_window, color=color.new(color.white, 100))
plot(in_overbought ? 1 : 0, "Overbought (1=Yes)", display=display.data_window, color=color.new(color.white, 100))
plot(n_harvest, "N_Harvest", display=display.data_window, color=color.new(color.white, 100))
plot(cash_buffer, "Cash Buffer ($)", display=display.data_window, color=color.new(color.teal, 100))
plot(peak_cash_buffer, "Peak Cash (Anchored) ($)", display=display.data_window, color=color.new(color.teal, 100))
plot(bar_deposit, "Deposit This Bar ($)", display=display.data_window, color=color.new(color.teal, 100))
plot(total_oop, "Total Out-of-Pocket ($)", display=display.data_window, color=color.new(color.teal, 100))
plot(harvest_dist_pct - dist_pct, "Dist to Harvest (%)", display=display.data_window, color=color.new(color.white, 100))
plot(pullback_pct, "Pullback from Peak (%)", display=display.data_window, color=color.new(color.white, 100))
plot(swing_high_peak, "Swing High Peak ($)", display=display.data_window, color=color.new(color.white, 100))
plot(t1_threshold, "Active T1 Threshold (%)", display=display.data_window, color=color.new(color.white, 100))
plot(total_shares, "Total Shares", display=display.data_window, color=color.new(color.lime, 100))
plot(portfolio_value, "Portfolio Value ($)", display=display.data_window, color=color.new(color.lime, 100))

float action_code = bar_action == "RISK-OFF EXIT" ? 6.0 :
     bar_action == "PROFIT TAKE" ? 5.0 :
     is_step ? 4.0 :
     is_tranche ? 3.0 :
     is_dca ? 2.0 : 0.0
plot(action_code, "Action (6=RiskOff,5=Harvest,4=Step,3=Tranche,2=DCA,0=Hold)", display=display.data_window, color=color.new(color.white, 100))

// =============================================================================
// TABLE — Live Dashboard (top-right)
// =============================================================================
var table dash = table.new(position.top_right, 2, 14, 
     bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(dash, 0, 0, "METRIC", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 0, "VALUE", text_color=color.gray, text_size=size.small, text_halign=text.align_right)
    
    // Dual Gate Status
    table.cell(dash, 0, 1, "DUAL GATE", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    string gate_str = dual_gate_open ? "OPEN (BUY OK)" : risk_off_active ? "RISK-OFF" : "CLOSED (PAUSED)"
    color gate_color = dual_gate_open ? color.green : risk_off_active ? color.purple : color.orange
    table.cell(dash, 1, 1, gate_str, text_color=gate_color, text_size=size.small, text_halign=text.align_right)
    
    // Gate Details
    table.cell(dash, 0, 2, "Price > EMA", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, gate_above_ema ? "YES" : "NO", text_color=gate_above_ema ? color.green : color.red, text_size=size.small, text_halign=text.align_right)
    
    table.cell(dash, 0, 3, "NDX > NDX EMA", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, gate_ndx_bullish ? "YES" : "NO", text_color=gate_ndx_bullish ? color.green : color.red, text_size=size.small, text_halign=text.align_right)
    
    // EMA Distance
    table.cell(dash, 0, 4, "EMA Dist %", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    dist_color = dist_pct >= harvest_dist_pct ? color.red : dist_pct >= hysteresis_pct ? color.orange : color.green
    table.cell(dash, 1, 4, str.tostring(dist_pct, "#.##") + "%", text_color=dist_color, text_size=size.small, text_halign=text.align_right)
    
    // State
    table.cell(dash, 0, 5, "State", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, in_overbought ? "OVERBOUGHT" : "NORMAL", 
         text_color=in_overbought ? color.red : color.green, text_size=size.small, text_halign=text.align_right)
    
    // Pullback
    table.cell(dash, 0, 6, "Pullback %", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    pb_color = pullback_pct <= t1_threshold ? color.green : color.white
    table.cell(dash, 1, 6, str.tostring(pullback_pct, "#.##") + "%", text_color=pb_color, text_size=size.small, text_halign=text.align_right)
    
    // Cash Buffer
    table.cell(dash, 0, 7, "Cash Buffer", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 7, "$" + str.tostring(cash_buffer, "#,###"), text_color=color.teal, text_size=size.small, text_halign=text.align_right)
    
    // Peak Cash
    table.cell(dash, 0, 8, "Peak Cash", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 8, "$" + str.tostring(peak_cash_buffer, "#,###"), text_color=color.teal, text_size=size.small, text_halign=text.align_right)
    
    // Shares
    table.cell(dash, 0, 9, "Shares", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 9, str.tostring(total_shares, "#,###.##"), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    // Portfolio
    table.cell(dash, 0, 10, "Portfolio $", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 10, "$" + str.tostring(portfolio_value, "#,###"), text_color=color.lime, text_size=size.small, text_halign=text.align_right)
    
    // Total OOP
    table.cell(dash, 0, 11, "Total OOP", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 11, "$" + str.tostring(total_oop, "#,###"), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    // Tranches
    string t_status = (t1_fired ? "T1" : "") + (t2_fired ? " T2" : "") + (t3_fired ? " T3" : "") + (t4_fired ? " T4" : "")
    table.cell(dash, 0, 12, "Tranches", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 12, t_status == "" ? "None" : t_status, text_color=color.green, text_size=size.small, text_halign=text.align_right)
    
    // N Harvest
    table.cell(dash, 0, 13, "N_Harvest", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 13, str.tostring(n_harvest), text_color=color.white, text_size=size.small, text_halign=text.align_right)
